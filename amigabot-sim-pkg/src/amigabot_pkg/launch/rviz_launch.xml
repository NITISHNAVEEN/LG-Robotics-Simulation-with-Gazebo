<launch>
    <let name="urdf_path" value="$(find-pkg-share amigbot_pkg)/urdf/groundbot/amigabot.urdf.xacro" />
    
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"></param>
    </node>

    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" />
    <!-- <node pkg="rviz2" exec="rviz2" output="screen" /> -->
    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(find-pkg-share amigbot_pkg)/config/launch_config.rviz"/>
</launch>