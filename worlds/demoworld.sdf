<sdf version='1.9'>
  <world name='empty'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='ignition-gazebo-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='ignition-gazebo-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='ignition-gazebo-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='ignition-gazebo-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <model name="open_box">
      <pose>-0.2 -0.33 0 0 -0 0</pose>
      <static>true</static>

      <!-- Base -->
      <link name="base_link">
        <visual name="base_vis">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box><size>0.2 0.2 0.0002</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.2 0.8 1.0</ambient>
            <diffuse>0.5 0.2 0.8 1.0</diffuse>
          </material>
        </visual>
        <collision name="base_col">
          <geometry>
            <box><size>0.2 0.2 0.0002</size></box>
          </geometry>
        </collision>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <!-- Left -->
      <link name="left_link">
        <pose>0 -0.1 0.05 1.57 0 0</pose>
        <visual name="left_vis">
          <geometry>
            <box><size>0.2 0.1 0.0002</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.2 0.8 1.0</ambient>
            <diffuse>0.5 0.2 0.8 1.0</diffuse>
          </material>
        </visual>
        <collision name="left_col">
          <geometry>
            <box><size>0.2 0.1 0.0002</size></box>
          </geometry>
        </collision>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <joint name="box_left" type="fixed">
        <parent>base_link</parent>
        <child>left_link</child>
        <pose>0 -0.1 0.05 0 0 0</pose>
      </joint>

      <!-- Right -->
      <link name="right_link">
        <pose>0 0.1 0.05 1.57 0 0</pose>
        <visual name="right_vis">
          <geometry>
            <box><size>0.2 0.1 0.0002</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.2 0.8 1.0</ambient>
            <diffuse>0.5 0.2 0.8 1.0</diffuse>
          </material>
        </visual>
        <collision name="right_col">
          <geometry>
            <box><size>0.2 0.1 0.0002</size></box>
          </geometry>
        </collision>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <joint name="box_right" type="fixed">
        <parent>base_link</parent>
        <child>right_link</child>
        <pose>0 0.1 0.05 0 0 0</pose>
      </joint>

      <!-- Front -->
      <link name="front_link">
        <pose>0.1 0 0.05 0 1.57 0</pose>
        <visual name="front_vis">
          <geometry>
            <box><size>0.1 0.2 0.0002</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.2 0.8 1.0</ambient>
            <diffuse>0.5 0.2 0.8 1.0</diffuse>
          </material>
        </visual>
        <collision name="front_col">
          <geometry>
            <box><size>0.1 0.2 0.0002</size></box>
          </geometry>
        </collision>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <joint name="box_front" type="fixed">
        <parent>base_link</parent>
        <child>front_link</child>
        <pose>0.1 0 0.05 0 0 0</pose>
      </joint>

      <!-- Back -->
      <link name="back_link">
        <pose>-0.1 0 0.05 0 1.57 0</pose>
        <visual name="back_vis">
          <geometry>
            <box><size>0.1 0.2 0.0002</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.2 0.8 1.0</ambient>
            <diffuse>0.5 0.2 0.8 1.0</diffuse>
          </material>
        </visual>
        <collision name="back_col">
          <geometry>
            <box><size>0.1 0.2 0.0002</size></box>
          </geometry>
        </collision>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <joint name="box_back" type="fixed">
        <parent>base_link</parent>
        <child>back_link</child>
        <pose>-0.1 0 0.05 0 0 0</pose>
      </joint>
    </model>

