<?xml version="1.0" encoding="utf-8"?>
<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="liquid_galaxy_arm">

  <xacro:include filename="ros2_control_plugins.xacro"/>

  <xacro:property name="m" value="30.0"/>
  <xacro:property name="x" value="0.12"/>
  <xacro:property name="y" value="0.2"/>
  <xacro:property name="z" value="0.01"/>

  <material name="green">
    <color rgba="0.313 0.729 0.423 1.0"/>
  </material>
  
  <material name="blue">
    <color rgba="0.101 0.337 0.698 1.0"/>
  </material>

  <link 
    name="base_link">
    <visual>
      <origin xyz="0.0 -0.02 ${z/2}" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${x} ${y} ${z}"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 ${z/2}" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${x} ${y} ${z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0.0 0.0 ${z/2}" rpy="0.0 0.0 0.0"/>
      <inertia ixx="${(m/12)*(y*y + z*z)}" ixy="0.0" ixz="0.0" 
                     iyy="${(m/12)*(x*x + z*z)}" iyz="0.0" 
                     izz="${(m/12)*(x*x + y*y)}"/>
    </inertial>
  </link>

  <joint name="base_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="Base"/>
    <origin xyz="0 0 0.007" rpy="0 0 0"/>
  </joint>
  <link
    name="Base">
    <inertial>
      <origin
        xyz="-2.4596E-07 0.0311 0.01757"
        rpy="0 0 0" />
      <mass
        value="0.1931" />
      <inertia
        ixx="0.00013"
        ixy="2.1013E-08"
        ixz="4.2408E-09"
        iyy="0.00016"
        iyz="2.2651E-05"
        izz="0.00014" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/models/Base.stl" />
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/decimated/simplify_Base.stl" />
      </geometry>
    </collision>
  </link>

  <link
    name="Shoulder_Rotation_Pitch">
    <inertial>
      <origin
        xyz="-9.0788E-05 0.059 0.031"
        rpy="0 0 0" />
      <mass
        value="0.1192" />
      <inertia
        ixx="5.904E-05"
        ixy="4.908E-07"
        ixz="-5.9045E-08"
        iyy="3.214986E-05"
        iyz="-4.5803E-06"
        izz="5.8606E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/models/Shoulder_Rotation_Pitch.stl" />
      </geometry>
      <material
        name="blue"/>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/decimated/simplify_Shoulder_Rotation_Pitch.stl" />
      </geometry>
    </collision>
  </link>
  <joint
    name="Shoulder_Rotation"
    type="revolute">
    <dynamics damping="0.3" friction="0.3"/>
    <limit lower="-3.14" upper="3.14" effort="100.0" velocity="100.0"/>
    <origin
      xyz="0 -0.0452 0.0165"
      rpy="1.5708 0 0" />
    <parent
      link="Base" />
    <child
      link="Shoulder_Rotation_Pitch" />
    <axis
      xyz="0 1 0" />
  </joint>
  <link
    name="Upper_Arm">
    <inertial>
      <origin
        xyz="-1.7205E-05 0.0701 0.0031"
        rpy="0 0 0" />
      <mass
        value="0.1624" />
      <inertia
        ixx="0.0002"
        ixy="1.039E-06"
        ixz="-1.2016E-08"
        iyy="7.0194E-05"
        iyz="2.1188E-06"
        izz="0.0002" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/models/Upper_Arm.stl" />
      </geometry>
      <material
        name="green"/>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/decimated/simplify_Upper_Arm.stl" />
      </geometry>
    </collision>
  </link>
  <joint
    name="Shoulder_Pitch"
    type="revolute">
    <dynamics damping="0.3" friction="0.3"/>
    <limit lower="-1.57" upper="1.57" effort="100.0" velocity="100.0"/>
    <origin
      xyz="0 0.1025 0.0306"
      rpy="0 0 0" />
    <parent
      link="Shoulder_Rotation_Pitch" />
    <child
      link="Upper_Arm" />
    <axis
      xyz="1 0 0" />
  </joint>
  <link
    name="Lower_Arm">
    <inertial>
      <origin
        xyz="-0.0034 0.0013 0.0768"
        rpy="0 0 0" />
      <mass
        value="0.1479" />
      <inertia
        ixx="0.0001"
        ixy="1.7306E-07"
        ixz="-1.172E-05"
        iyy="0.00014"
        iyz="1.7743E-06"
        izz="5.0874E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/models/Lower_Arm.stl" />
      </geometry>
      <material
        name="blue"/>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/decimated/simplify_Lower_Arm.stl" />
      </geometry>
    </collision>
  </link>
  <joint
    name="Elbow"
    type="revolute">
    <dynamics damping="0.3" friction="0.3"/>
    <limit lower="-1.57" upper="1.57" effort="100.0" velocity="100.0"/>
    <origin
      xyz="0 0.11257 0.028"
      rpy="0 0 0" />
    <parent
      link="Upper_Arm" />
    <child
      link="Lower_Arm" />
    <axis
      xyz="1 0 0" />
  </joint>
  <link
    name="Wrist_Pitch_Roll">
    <inertial>
      <origin
        xyz="-0.0085 -0.0352 -2.3462E-05"
        rpy="0 0 0" />
      <mass
        value="0.0661" />
      <inertia
        ixx="1.9572E-05"
        ixy="-6.6271E-07"
        ixz="5.20089E-09"
        iyy="2.3803E-05"
        iyz="4.0955E-08"
        izz="3.454E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/models/Wrist_Pitch_Roll.stl" />
      </geometry>
      <material
        name="blue"/>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/decimated/simplify_Wrist_Pitch_Roll.stl" />
      </geometry>
    </collision>
  </link>
  <joint
    name="Wrist_Pitch"
    type="revolute">
    <dynamics damping="0.3" friction="0.3"/>
    <limit lower="-1.57" upper="1.57" effort="100.0" velocity="100.0"/>
    <origin
      xyz="0 0.0052 0.1349"
      rpy="0 0 0" />
    <parent
      link="Lower_Arm" />
    <child
      link="Wrist_Pitch_Roll" />
    <axis
      xyz="1 0 0" />
  </joint>
  <link
    name="Fixed_Gripper">
    <inertial>
      <origin
        xyz="0.0055 -0.02801 0.0004"
        rpy="0 0 0" />
      <mass
        value="0.093" />
      <inertia
        ixx="4.333E-05"
        ixy="7.0965E-06"
        ixz="5.998E-07"
        iyy="3.044E-05"
        iyz="-1.5874E-07"
        izz="5.0246E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/models/Fixed_Gripper.stl" />
      </geometry>
      <material
        name="green"/>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/decimated/simplify_Fixed_Gripper.stl" />
      </geometry>
    </collision>
  </link>
  <joint
    name="Wrist_Roll"
    type="revolute">
    <dynamics damping="0.3" friction="0.3"/>
    <limit lower="-3.14" upper="3.14" effort="100.0" velocity="100.0"/>
    <origin
      xyz="0 -0.0601 0"
      rpy="0 0 0" />
    <parent
      link="Wrist_Pitch_Roll" />
    <child
      link="Fixed_Gripper" />
    <axis
      xyz="0 1 0" />
  </joint>
  <link
    name="Moving_Jaw">
    <inertial>
      <origin
        xyz="-0.0016 -0.030 0.0004"
        rpy="0 0 0" />
      <mass
        value="0.0202" />
      <inertia
        ixx="1.1091E-05"
        ixy="-5.35E-07"
        ixz="-9.4613E-09"
        iyy="3.0357E-06"
        iyz="-1.711E-07"
        izz="8.991E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/models/Moving_Jaw.stl" />
      </geometry>
      <material
        name="green"/>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://lg_arm/assets/decimated/simplify_Moving_Jaw.stl" />
      </geometry>
    </collision>
  </link>
  <joint
    name="Gripper"
    type="revolute">
    <dynamics damping="0.3" friction="0.3"/>
    <limit lower="-0.2" upper="1.37" effort="100.0" velocity="100.0"/>
    <origin
      xyz="-0.0202 -0.0244 0"
      rpy="3.1416 0 3.1416" />
    <parent
      link="Fixed_Gripper" />
    <child
      link="Moving_Jaw" />
    <axis
      xyz="0 0 1" />
  </joint>
</robot>